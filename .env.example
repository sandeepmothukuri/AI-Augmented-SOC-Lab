# Wazuh SIEM
WAZUH_DASHBOARD_PORT=443
WAZUH_INDEXER_PORT=9200
WAZUH_AGENT_PORT=1514
WAZUH_REG_PORT=1515
WAZUH_SYSLOG_PORT=514
WAZUH_API_PORT=55000
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASS=SecretPassword

# TheHive & Cortex
THEHIVE_PORT=9000
CORTEX_PORT=9001
THEHIVE_API_KEY=your_thehive_api_key

# Shuffle SOAR
SHUFFLE_FRONTEND_PORT=3001
SHUFFLE_FRONTEND_SSL=3443
SHUFFLE_BACKEND_PORT=5001
SHUFFLE_OPENSEARCH_PORT=9202
SHUFFLE_DB_PORT=8000
SHUFFLE_USER=admin
SHUFFLE_PASS=password
SHUFFLE_APIKEY=mysupersecretkey

# MISP CTI Platform
MISP_HTTP_PORT=8080
MISP_HTTPS_PORT=8443

# Ollama & AI SOC Engine
OLLAMA_PORT=11434
AI_ENGINE_PORT=8888
MODEL_NAME=llama3
LOG_LEVEL=INFO
