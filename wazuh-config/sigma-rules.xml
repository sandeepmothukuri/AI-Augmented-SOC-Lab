<?xml version="1.0" ?>
<group name="sigma-compiled,custom">
  <rule id="100020" level="8">
    <regex type="pcre2">(?i)(history\ \-c|rm\ \*bash_history|rm\ \-f\ \~/\.bash_history|unset\ HISTFILE|export\ HISTSIZE=0|shopt\ \-u\ \-o\ history)</regex>
    <description>[Sigma] Shell Command History Cleared</description>
    <group>sigma,custom,linux</group>
    <mitre>
      <id>T1070.003</id>
    </mitre>
  </rule>
  <rule id="100021" level="12">
    <if_group>auditd</if_group>
    <regex type="pcre2">(?i)(/etc/sudoers|/etc/sudoers\.d/)</regex>
    <match>echo</match>
    <description>[Sigma] Unauthorized Sudoers File Tampering</description>
    <group>sigma,custom,linux,auditd</group>
    <mitre>
      <id>T1548.003</id>
    </mitre>
  </rule>
  <rule id="100022" level="12">
    <decoded_as>zeek</decoded_as>
    <match>TXT</match>
    <field name="dns.query_length" type="pcre2">[4-9]\d|[1-9]\d{2,}</field>
    <description>[Sigma] DNS Tunneling High Entropy Queries</description>
    <group>sigma,custom,zeek,dns</group>
    <mitre>
      <id>T1071.004</id>
    </mitre>
  </rule>
  <rule id="100023" level="12">
    <if_group>windows,sysmon_process_creation</if_group>
    <regex type="pcre2">(?i)(\\powershell\.exe|\\pwsh\.exe)</regex>
    <regex type="pcre2">(?i)(DownloadString|DownloadFile|Invoke\-WebRequest|Net\.WebClient|iwr|curl)</regex>
    <description>[Sigma] Suspicious PowerShell Download Cradle</description>
    <group>sigma,custom,windows,process_creation</group>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>
  <rule id="100024" level="14">
    <if_group>web,accesslog</if_group>
    <match>GET</match>
    <regex type="pcre2">(?i)(UNION\ SELECT|UNION\ ALL\ SELECT|ORDER\ BY\ 1\-\-|AND\ 1=1|OR\ 1=1)</regex>
    <description>[Sigma] Web Application SQL Injection via UNION SELECT</description>
    <group>sigma,custom,webserver</group>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>
</group>
